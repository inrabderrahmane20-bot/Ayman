# Canonical origin of the deployment. Never set this to a domain the project
# does not control. Defaults to https://ayman-nu.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://ayman-nu.vercel.app

# GA4 measurement ID (optional). Analytics only loads after the visitor accepts.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Personal protection page stays unindexed and unlinked. The route returns 404
# unless this is exactly "true". Do not enable before licensing, insurance,
# staffing and operations have been verified.
NEXT_PUBLIC_PROTECTION_LIVE=false

# Lead delivery. Leave both unset to use the honest WhatsApp/email fallback.
# Option 1: Resend (https://resend.com). LEAD_FROM_EMAIL must be a verified sender.
RESEND_API_KEY=
LEAD_TO_EMAIL=aymanyakhmim1@gmail.com
LEAD_FROM_EMAIL=AYMAN Website <onboarding@resend.dev>

# Option 2: forward leads to an automation/webhook (takes precedence over Resend).
LEAD_WEBHOOK_URL=

# Optional extra origin allowed to submit the form (e.g. a custom domain).
LEAD_ALLOWED_ORIGIN=
